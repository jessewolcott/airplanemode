# FriendlyElec NanoPi R6S (RK3588S, 8 GB RAM, arm64) running FriendlyWrt with Docker.
# Full profile: shared language model enabled.
# Copy to .env in the repo root:  cp hardware/nanopi-r6s.env .env

COMPOSE_PROFILES=llm

# LuCI already uses port 80 on FriendlyWrt.
HTTP_PORT=8080
# The router's LAN address (FriendlyWrt default). The front door listens only here,
# never on the upstream (hotel) side. Change it if you changed the LAN subnet.
LAN_IP=192.168.2.1

# Shared model (decision 0018). Gemma 4 E2B Q4 is ~3.1 GB on disk; most of that is per-layer
# embeddings read from disk as needed, so it uses about 1.5 GB of RAM (peak ~2.6 GB).
LLM_MODEL=unsloth/gemma-4-E2B-it-GGUF:Q4_K_M
# To try Google's quantization-aware Q4_0 build (3.1 GB; llama.cpp has faster Arm kernels for
# Q4_0), use this instead, then rerun the model apps' evals (decision 0020). Untested on the R6S.
#LLM_MODEL=google/gemma-4-E2B-it-qat-q4_0-gguf
# The RK3588S has 4 slow Cortex-A55 cores (0-3) and 4 fast Cortex-A76 cores (4-7). Run the
# model on the fast ones only (decision 0024). Untested: check the numbering on the box with
# grep "CPU part" /proc/cpuinfo   (0xd05 = A55, 0xd0b = A76).
LLM_CPUS=4-7
LLM_THREADS=4
# Prompt cache in RAM: the model apps' long instructions are processed once, then reused.
LLM_CACHE_RAM=256
LLM_SLOTS=2
LLM_CTX=4096
LLM_MEM=3500m

PROXY_MEM=64m
ADMIN_MEM=96m
DARKLIGHT_MEM=256m
DROP_MEM=128m
CINEMA_MEM=64m
QUICKSHOT_MEM=64m
TV_MEM=64m
DOOM_MEM=32m
GATECHANGE_MEM=64m
PASSPORT_MEM=64m
WAYFARER_MEM=64m
COUCH_MEM=64m
GUIDE_MEM=256m
# Shared files (Drop): total space on the eMMC, largest single file.
DROP_MAX_BYTES=4g
DROP_MAX_FILE=2g

# Router control for the admin panel (FriendlyWrt's ubus API, the same one LuCI uses).
# If the admin panel can't reach it, set ROUTER_URL to http://<router-lan-ip>/ubus.
ROUTER_BACKEND=openwrt
ROUTER_URL=http://host.docker.internal/ubus
# scripts/router-setup.sh creates a Wi-Fi-only router login and writes ROUTER_USER and
# ROUTER_PASSWORD into your .env; scripts/update.sh adds ADMIN_PASSWORD. Don't put the
# router's root password here.

