{
	"airplanemode": {
		"description": "AirplaneMode admin service: Wi-Fi, VPN and device settings only (installed by scripts/router-setup.sh)",
		"read": {
			"ubus": {
				"uci": [ "get", "changes" ],
				"iwinfo": [ "info", "scan", "devices" ],
				"network.interface": [ "status", "dump" ],
				"network.device": [ "status" ],
				"luci-rpc": [ "getDHCPLeases" ],
				"luci.wireguard": [ "getWgInstances" ]
			},
			"uci": [ "wireless", "network", "firewall", "dhcp" ]
		},
		"write": {
			"ubus": {
				"uci": [ "set", "add", "delete", "apply", "revert" ]
			},
			"uci": [ "wireless", "network", "firewall", "dhcp" ]
		}
	}
}
