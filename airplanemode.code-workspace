{
	// Open this file in VS Code to work on the platform and its apps together:
	//   code H:\Github\airplanemode\airplanemode\airplanemode.code-workspace
	// All repos live side by side in one project folder (H:\Github\airplanemode\<repo>);
	// clone the app repos next to this one.
	"folders": [
		{ "name": "airplanemode (platform)", "path": "." },
		{ "name": "airplanemode-darklight", "path": "../airplanemode-darklight" },
		{ "name": "airplanemode-drop", "path": "../airplanemode-drop" },
		{ "name": "airplanemode-guide", "path": "../airplanemode-guide" },
		{ "name": "airplanemode-cinema", "path": "../airplanemode-cinema" },
		{ "name": "airplanemode-quickshot", "path": "../airplanemode-quickshot" },
		{ "name": "airplanemode-doom", "path": "../airplanemode-doom" },
		{ "name": "airplanemode-site", "path": "../airplanemode-site" }
	],
	"settings": {
		"files.associations": {
			"Caddyfile": "caddyfile",
			"*.env": "dotenv",
			".env": "dotenv"
		},
		// these files run on the Linux box: keep LF even when edited on Windows
		"[shellscript]": { "files.eol": "\n" },
		"[dotenv]": { "files.eol": "\n" },
		"[yaml]": { "files.eol": "\n" },
		"[caddyfile]": { "files.eol": "\n" },
		"files.exclude": {
			"**/__pycache__": true
		},
		"python.terminal.activateEnvironment": true
	},
	"extensions": {
		"recommendations": [
			"anthropic.claude-code",
			"ms-python.python",
			"ms-azuretools.vscode-containers",
			"redhat.vscode-yaml",
			"github.vscode-github-actions",
			"matthewpi.caddyfile-support",
			"timonwong.shellcheck",
			"mikestead.dotenv",
			"bierner.markdown-mermaid"
		]
	}
}
