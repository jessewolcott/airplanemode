# GL.iNet arm64 routers with Docker installed on USB/SD storage
# (for example Flint 2 / GL-MT6000 with 1 GB RAM). Not yet tested on hardware.
# Lite profile: no language model. Apps fall back to their plain-text mode.
# Copy to .env in the repo root:  cp hardware/glinet.env .env

COMPOSE_PROFILES=

# The GL.iNet admin panel already uses port 80.
HTTP_PORT=8080
# The router's LAN address (GL.iNet default). The front door listens only here,
# never on the upstream (hotel) side. Change it if you changed the LAN subnet.
LAN_IP=192.168.8.1

# Empty = apps don't try to reach a model at all.
LLM_URL=

PROXY_MEM=48m
ADMIN_MEM=80m
DARKLIGHT_MEM=128m
DROP_MEM=128m
CINEMA_MEM=64m
QUICKSHOT_MEM=64m
DOOM_MEM=32m
# The Travel Guide needs ~260 MB of storage for Wikivoyage.
GUIDE_MEM=192m
# Shared files (Drop) live on the USB/SD storage: keep them small.
DROP_MAX_BYTES=1g
DROP_MAX_FILE=512m

# Router control for the admin panel. GL.iNet firmware is OpenWrt underneath, but its own
# repeater manager also edits these settings; see docs/hardware.md before using both.
ROUTER_BACKEND=openwrt
ROUTER_URL=http://host.docker.internal/ubus
# scripts/router-setup.sh creates a Wi-Fi-only router login and writes ROUTER_USER and
# ROUTER_PASSWORD into your .env; scripts/update.sh adds ADMIN_PASSWORD. Don't put the
# router's root password here.

