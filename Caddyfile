# Plain HTTP on the LAN: there is no public name to get a certificate for, and the box is offline.
{
	auto_https off
	admin off
}

:80 {
	# zstd where the browser takes it (cheaper for the box's CPU than gzip), gzip otherwise.
	# Video, audio and images aren't compressed; already-compressed responses pass through.
	encode zstd gzip

	# ---- offline popup ----
	# With no internet at all, the router answers every DNS name with a fake address and a
	# firewall rule forwards it here (see admin/router.py). So a request for any other hostname
	# (captive.apple.com, connectivitycheck.gstatic.com, ...) is a phone checking for a sign-in
	# page: send it to the landing page, which the phone then shows as a sign-in screen.
	# A bare IP address is someone typing the box's address (or a laptop's, in dev), never a
	# sign-in check, so it's served as is.
	@elsewhere {
		not host {$LAN_IP:127.0.0.1} airplane.mode localhost
		not expression `{http.request.host}.matches("^[0-9.]+$") || {http.request.host}.contains(":")`
	}
	redir @elsewhere http://{$LAN_IP:127.0.0.1}:{$HTTP_PORT:8080}/ 302

	# ---- apps: one block per app. The prefix is stripped before the app sees the request. ----
	redir /darklight /darklight/
	handle_path /darklight/* {
		reverse_proxy darklight:8000
	}

	redir /drop /drop/
	handle_path /drop/* {
		reverse_proxy drop:8000 {
			# Drop checks who may have a file, then answers with X-Accel-Redirect: /files/<id>
			# and Caddy sends the bytes from Drop's volume (read-only here), with ranges and
			# sendfile, instead of every film streaming through Drop's Python process.
			header_up X-Sendfile-Type X-Accel-Redirect
			@accel header X-Accel-Redirect /files/*
			handle_response @accel {
				root * /srv/drop
				rewrite * {rp.header.X-Accel-Redirect}
				copy_response_headers {
					include Content-Type Content-Disposition Content-Security-Policy X-Content-Type-Options Cache-Control
				}
				file_server
			}
		}
	}

	redir /cinema /cinema/
	handle_path /cinema/* {
		reverse_proxy cinema:8000
	}

	redir /quickshot /quickshot/
	handle_path /quickshot/* {
		reverse_proxy quickshot:8000
	}

	redir /doom /doom/
	handle_path /doom/* {
		reverse_proxy doom:8000
	}

	redir /guide /guide/
	handle_path /guide/* {
		reverse_proxy guide:8000
	}

	redir /gatechange /gatechange/
	handle_path /gatechange/* {
		reverse_proxy gatechange:8000
	}

	redir /passport /passport/
	handle_path /passport/* {
		reverse_proxy passport:8000
	}

	redir /wayfarer /wayfarer/
	handle_path /wayfarer/* {
		reverse_proxy wayfarer:8000
	}

	redir /couch /couch/
	handle_path /couch/* {
		reverse_proxy couch:8000
	}

	# ---- platform: status API and admin panel (reserved paths: no app may use /api or /admin) ----
	redir /admin /admin/
	handle /api/* {
		reverse_proxy admin:8000
	}
	handle /admin/* {
		reverse_proxy admin:8000
	}

	# ---- landing page + app menu ----
	handle {
		root * /srv/portal
		file_server
	}
}
