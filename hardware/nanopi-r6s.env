# FriendlyElec NanoPi R6S (RK3588S, 8 GB RAM, arm64) running FriendlyWrt with Docker.
# Full profile: shared language model enabled.
# Copy to .env in the repo root:  cp hardware/nanopi-r6s.env .env

COMPOSE_PROFILES=llm

# LuCI already uses port 80 on FriendlyWrt.
HTTP_PORT=8080

# Shared model. 1.5B Q4 is ~1.1 GB on disk, ~1.5 GB in RAM.
# The RK3588S has 4 fast Cortex-A76 cores; use only those.
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct-GGUF:Q4_K_M
LLM_THREADS=4
LLM_SLOTS=2
LLM_CTX=4096
LLM_MEM=3g

PROXY_MEM=64m
DARKLIGHT_MEM=256m
